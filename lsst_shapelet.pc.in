prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib
doxygen_tag=${prefix}/doc/shapelet.tag
lsst_build_requires=boost_test pybind11 python3

Name: lsst_shapelet
Description: LSST Science Pipelines shapelet basis functions
Version: @VERSION@
Requires: lsst_cpputils lsst_afw
Cflags: -I${includedir}
Libs: -L${libdir} -lshapelet
